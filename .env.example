# ---------------------------------------------------------------- required ----

# Postgres with the pgvector extension. Must use the asyncpg driver.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/ragdb

# Minimum 32 characters; startup fails on a short or placeholder value.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECURITY__SECRET_KEY=

GROQ_API_KEY=

# ---------------------------------------------------------------- optional ----

ENVIRONMENT=development                  # development | staging | production
CORS_ORIGINS=["http://localhost:3000"]
RATE_LIMIT_PER_MINUTE=60
MAX_UPLOAD_BYTES=26214400                # 25MB

OBSERVABILITY__LOG_LEVEL=INFO
OBSERVABILITY__LOG_FORMAT=console        # console for local, json in deployment
OBSERVABILITY__EXPOSE_DEBUG_TIMINGS=true # per-stage retrieval timings in responses

# --- database pooling ---
# Set DB__POOL_SIZE=0 to use NullPool, and DB__DISABLE_STATEMENT_CACHE=true when
# connecting through pgbouncer, Neon's pooled endpoint, or from serverless.
DB__POOL_SIZE=5
DB__MAX_OVERFLOW=10
DB__DISABLE_STATEMENT_CACHE=false

# --- retrieval tuning ---
RETRIEVAL__STRATEGY=hybrid               # hybrid | vector | keyword
RETRIEVAL__TOP_K=6                       # passages sent to the model
RETRIEVAL__CANDIDATE_K=40                # fetched per leg before fusion
RETRIEVAL__MIN_SIMILARITY=0.25           # relevance floor; raise to refuse more often
RETRIEVAL__MMR_ENABLED=true
RETRIEVAL__MMR_LAMBDA=0.7                # 1.0 = pure relevance, 0.0 = pure diversity
RETRIEVAL__RERANK_ENABLED=true           # cross-encoder; costs ~200MB RAM + latency
RETRIEVAL__HNSW_EF_SEARCH=200

# --- chunking (changing these requires re-ingesting documents) ---
CHUNKING__CHUNK_SIZE=1200
CHUNKING__CHUNK_OVERLAP=180

# --- embeddings (changing the model requires a migration + full re-embed) ---
EMBEDDING__MODEL_NAME=all-MiniLM-L6-v2
EMBEDDING__DIM=384

# --- generation ---
GENERATION__MODEL=llama-3.3-70b-versatile
GENERATION__TEMPERATURE=0.1
GENERATION__HISTORY_TURNS=6
GENERATION__CONTEXTUALIZE_QUERIES=true   # rewrite follow-ups before retrieval
GENERATION__CONTEXTUALIZE_MODEL=llama-3.1-8b-instant
